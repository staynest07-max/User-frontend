# Full API v1 base URL. Do not append endpoint paths here.
# Physical device/LAN example:
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:4000/api/v1

# Android emulator commonly uses http://10.0.2.2:4000/api/v1.
# Use environment-specific values for staging and production. No secrets belong
# in EXPO_PUBLIC_* variables because Expo embeds them in the client bundle.
